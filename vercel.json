{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
   "routes": [
    { "src": "/", "dest": "/public/landingindex.html" },
    { "src": "/start", "dest": "/public/index.html" },
    { "src": "/dist/(.*)", "dest": "/public/dist/$1" },

    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/mock/(.*)", "dest": "/api/index.js" }
  ]
}